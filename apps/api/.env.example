# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Frontend URL (used for CORS default)
WEB_URL=http://localhost:3000

# Additional allowed CORS origins (comma-separated)
# Example for production: https://your-app.vercel.app,https://custom-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/vedaai_assessment_creator
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/vedaai?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/vedaai_assessment_creator

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local:  redis://localhost:6379
# Hosted: rediss://:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: mock | gemini | groq
AI_PROVIDER=mock
AI_FALLBACK_TO_GROQ=false
AI_FALLBACK_TO_MOCK=true

# ─── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4

# ─── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.4
